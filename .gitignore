# Embeddings Service .gitignore (Hybrid Rust/Python)

# Universal
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.git/

# Rust
/target
**/target/
**/*.rs.bk
Cargo.lock

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# Environment
.env
.env.*
.map.env
.secret.env
!.env.example
!.map.env.example
!.secret.env.example

# Logs
*.log
logs/
embeddings/

# Caches / Models
.fastembed_cache/
.huggingface/
.cache/
models/

pytest.*